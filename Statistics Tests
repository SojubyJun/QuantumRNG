def make_classical_bit(bits):
    return random.getrandbits(bits)


def make_csprng_bit(bits):
    return secrets.randbits(bits)


def make_qrng_bit(bits):
    import cirq


    qubits = [cirq.LineQubit(i) for i in range(bits)]
    circuit = cirq.Circuit()
    circuit.append(cirq.H.on_each(*qubits))
    circuit.append(cirq.measure(*qubits, key="result"))
    simulator = cirq.Simulator()
    result = simulator.run(circuit)
    measured_bits = result.measurements["result"][0]
    return int("".join(str(bit) for bit in measured_bits[::-1]), 2)


def make_trng_bit(num_bits):
    """TRNG: Fetches true physical entropy/randomness from Random.org."""
    # Calculate max possible value for given bit size (e.g., 8 bits -> 0 to 255)
    max_val = (1 << num_bits) - 1


    url = f"https://www.random.org/integers/?num=1&min=0&max={max_val}&col=1&base=10&format=plain&rnd=new"


    try:
        response = requests.get(url, timeout=5)
        if response.status_code == 200:
            return int(response.text.strip())
        else:
            raise ValueError(f"TRNG API Error: {response.status_code}. Could not fetch true random number.")
    except Exception as e:
        raise ValueError(f"TRNG network fetch failed: {e}. Could not fetch true random number.") from e


def get_random_number(rng_choice, bits=8):
    if rng_choice == "PRNG":
        return make_classical_bit(bits)
    elif rng_choice == "CSPRNG":
        return make_csprng_bit(bits)
    elif rng_choice == "TRNG":
        return make_trng_bit(bits)
    elif rng_choice == "QRNG":
        return make_qrng_bit(bits)
    else:
        return make_classical_bit(bits)

# --- Statistical Test Functions (Moved to Global Scope) ---
def frequency_test(bit_string):
    n = len(bit_string)
    count_ones = bit_string.count('1')
    count_zeros = bit_string.count('0')

    # The test statistic
    s = (count_ones - count_zeros) / sqrt(n)

    # The p-value
    p_value = erfc(abs(s) / sqrt(2))

    return p_value

def runs_test(bit_string):
    n = len(bit_string)
    runs = 1  # Start with the first run
    for i in range(1, n):
        if bit_string[i] != bit_string[i - 1]:
            runs += 1

    n0 = bit_string.count('0')
    n1 = bit_string.count('1')

    # Expected number of runs
    expected_runs = (2 * n0 * n1 / n) + 1
    variance_runs = (2 * n0 * n1 * (2 * n0 * n1 - n)) / (n ** 2 * (n - 1))

    # The test statistic
    z = (runs - expected_runs) / sqrt(variance_runs)

    # The p-value
    p_value = erfc(abs(z) / sqrt(2))

    return p_value

def cumulative_sums_test(bit_string):
    bit_array = np.array([int(bit) for bit in bit_string])
    adjusted = 2 * bit_array - 1
    cumulative_sum = np.cumsum(adjusted)
    max_excursion = np.max(np.abs(cumulative_sum))
    return max_excursion

def longest_run_ones_test(bit_string, block_size=100):
    bit_array = np.array([int(bit) for bit in bit_string])
    num_blocks = len(bit_array) // block_size
    if num_blocks == 0:
        return 0.0
    max_runs = []
    for i in range(num_blocks):
        block = bit_array[i*block_size:(i+1)*block_size]
        runs_of_ones = [len(list(g)) for k, g in itertools.groupby(block) if k == 1]
        if runs_of_ones:
            max_runs.append(max(runs_of_ones))
        else:
            max_runs.append(0)
    if max_runs:
        return np.mean(max_runs)
    return 0.0

def unique_subsequences(bit_string, length=4):
    bit_array = np.array([int(bit) for bit in bit_string])
    n = len(bit_array)
    subsequences = set()

    for i in range(n - length + 1):
        subseq = tuple(bit_array[i:i+length])
        subsequences.add(subseq)

    return len(subsequences)

def calculate_min_entropy(sequence):
    if isinstance(sequence, str):
        sequence = np.array([int(bit) for bit in sequence])
    elif not isinstance(sequence, np.ndarray):
        sequence = np.asarray(sequence, dtype=float)

    if len(sequence) == 0:
        return 0.0

    p = np.mean(sequence)
    max_prob = max(p, 1 - p)
    if max_prob == 0:
        return 0.0

    min_entropy = -np.log2(max_prob)
    return min_entropy

